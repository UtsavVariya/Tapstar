# Environment Variables
# Copy this file to .env and fill in the values

# Database - SQLite (default for development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL/Supabase (production):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-admin-password-here"

# JWT Secret (generate a random 64-char string)
JWT_SECRET="change-this-to-a-random-64-character-secret-key-for-production"

# AI Review Generation (optional - fallback templates work without this)
# Option 1: Google Gemini API
GEMINI_API_KEY=""

# Option 2: OpenAI API
OPENAI_API_KEY=""

# App URL (your custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
